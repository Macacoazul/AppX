<?xml version="1.0" encoding="utf-8"?>
<!-- Layout de cada post exibido na ListView -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:descendantFocusability="blocksDescendants"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_avatar"
        android:gravity="center"
        android:textColor="@color/branco"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="AS" />

    <!-- Cabeçalho: nome, selo de verificado, @usuário · tempo e menu -->
    <LinearLayout
        android:id="@+id/cabecalho"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/avatar"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/nome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxWidth="170dp"
            android:singleLine="true"
            android:textColor="@color/x_texto"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Ana Souza" />

        <ImageView
            android:id="@+id/verificado"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="2dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_verified"
            app:tint="@color/x_azul" />

        <TextView
            android:id="@+id/info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/x_cinza"
            android:textSize="15sp"
            tools:text="\@anasouza · 2h" />

        <ImageView
            android:id="@+id/btnMais"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/desc_mais"
            app:srcCompat="@drawable/ic_more"
            app:tint="@color/x_cinza" />
    </LinearLayout>

    <TextView
        android:id="@+id/texto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/x_texto"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/cabecalho"
        app:layout_constraintTop_toBottomOf="@id/cabecalho"
        tools:text="Texto do post" />

    <!-- Imagem opcional do post (cantos arredondados) -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imagem"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:importantForAccessibility="no"
        android:padding="0.5dp"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/cabecalho"
        app:layout_constraintTop_toBottomOf="@id/texto"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.AppX.Midia"
        app:strokeColor="@color/x_divisor"
        app:strokeWidth="1dp"
        tools:src="@drawable/img_por_do_sol" />

    <!-- Ações: responder, repostar, curtir, visualizações, salvar e compartilhar -->
    <LinearLayout
        android:id="@+id/acoes"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/cabecalho"
        app:layout_constraintTop_toBottomOf="@id/imagem">

        <LinearLayout
            android:id="@+id/btnResponder"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/desc_responder"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_reply"
                app:tint="@color/x_cinza" />

            <TextView
                android:id="@+id/qtdRespostas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:singleLine="true"
                android:textColor="@color/x_cinza"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnRepostar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/desc_repostar"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iconeRepost"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_repost"
                app:tint="@color/x_cinza" />

            <TextView
                android:id="@+id/qtdReposts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:singleLine="true"
                android:textColor="@color/x_cinza"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnCurtir"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/desc_curtir"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iconeCurtida"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_heart"
                app:tint="@color/x_cinza" />

            <TextView
                android:id="@+id/qtdCurtidas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:singleLine="true"
                android:textColor="@color/x_cinza"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnVisualizacoes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/desc_visualizacoes"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_views"
                app:tint="@color/x_cinza" />

            <TextView
                android:id="@+id/qtdVisualizacoes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:singleLine="true"
                android:textColor="@color/x_cinza"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnSalvar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/desc_salvar"
            android:padding="7dp"
            app:srcCompat="@drawable/ic_bookmark"
            app:tint="@color/x_cinza" />

        <ImageView
            android:id="@+id/btnCompartilhar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/desc_compartilhar"
            android:padding="7dp"
            app:srcCompat="@drawable/ic_share"
            app:tint="@color/x_cinza" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
